# GCP / Firebase
GOOGLE_CLOUD_PROJECT=calmnest-e910e
FIREBASE_STORAGE_BUCKET=calmnest-e910e.firebasestorage.app

# GCE VM (cloud worker only)
GCE_ZONE=us-central1-a
GCE_VM_NAME=calmdemy-worker
MODEL_DIR=/mnt/models
JOB_CACHE_DIR=/mnt/models/job_cache

# Worker behavior
IDLE_SHUTDOWN_MINUTES=5
POLL_INTERVAL_SECONDS=15

# Gemini API (for 'api' backend — LLM and TTS)
GEMINI_API_KEY=your_gemini_api_key

# Local LLM servers (for 'local' backend)
LMSTUDIO_HOST=http://localhost:1234
OLLAMA_HOST=http://localhost:11434
